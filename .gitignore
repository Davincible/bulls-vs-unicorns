package-lock.json
# ...EXCEPT the repo-root one, which is a deploy input rather than a stray artefact.
# `vercel.json`'s installCommand runs `npm ci` here to install the dependencies of the Vercel
# Functions in `/api`, and `npm ci` fails outright without a lockfile. Ignored everywhere else
# because `er-demo/` and `engine/` are bun and npm-install respectively and a stray lock there is
# noise. See `er-demo/api/README.md`.
!/package-lock.json
.devnet/

# Build toolchains and vendored SDKs — enormous, machine-specific, and never source.
# `git add -A` swept 6,496 files / 8.2M lines of Windows SDK headers into a commit once.
.toolchain/
.xwin-cache/
target/

# Toolchain artefacts fetched to make an MSVC-target build work without Visual Studio
# (see EXECUTION_REPORT.md ER-010). Thousands of vendored Windows SDK files — reproducible with
# `xwin splat`, and they have no business in the repo.
.toolchain/
.xwin-cache/
target/

# The round keeper's published status file. Generated once a second by a running keeper, and its
# ABSENCE is meaningful: the front end reads a 404 as "no keeper is running here", which is the
# correct answer on a fresh checkout. Committing one would ship a permanently stale heartbeat.
er-demo/public/keeper-status.json

# Local agent/editor tooling state — machine-specific, never source.
.opencode/
.localindex/
.claude/settings.local.json
.vercel
.env*
