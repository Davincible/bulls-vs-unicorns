# Bulls ⚔ Unicorns engine — environment. Copy to `.env` for local, or set these as host secrets.
# Only the first two blocks matter for a real launch; the rest have sane defaults.

# ── Core ────────────────────────────────────────────────────────────────────
PORT=8090
# The Solana RPC. Anything matching localhost/127.0.0.1/devnet/testnet is treated as a TEST chain
# (faucets on, allowlist + reconciliation freeze OFF, vault key may auto-generate). A mainnet URL
# flips all of those to production behaviour.
SOLANA_RPC=https://api.devnet.solana.com
# Where the SQLite ledger lives. In Docker this is the mounted volume (/data).
LEDGER_DIR=./data
# Point at mainnet.json instead of the devnet default when going live.
# CHAIN_CONFIG=./mainnet.json

# ── Custody & launch gate (PRODUCTION) ──────────────────────────────────────
# The vault keypair as a JSON byte array, e.g. [12,34,...]. Loaded from here first (secret manager),
# then from the gitignored .vault-keypair.json. On a live chain, a MISSING key is fatal (no silent
# new vault). NEVER commit the real value.
# VAULT_SECRET_KEY=[...]
# Closed beta: comma-separated wallet pubkeys allowed to play on a live chain (see also
# data/whitelist.txt). Empty on a live chain = nobody can play.
# WHITELIST=Wa11et1...,Wa11et2...
# Override the auto chain-detection if needed:
# ALLOWLIST_ENFORCE=1   # force the whitelist on (e.g. staging against mainnet data)
# ALLOWLIST_OFF=1       # force it off — NEVER on a real launch
# RECONCILE_ENFORCE=1   # force withdrawal-freeze-on-breach on
# RECONCILE_OFF=1       # force it off — NEVER on a real launch
# DISABLE_FAUCET=1      # extra belt-and-braces; faucets are already off on non-test chains
# SOL_USD=150           # pin the SOL price instead of the live feed (test chains only)

# ── Reconciliation ──────────────────────────────────────────────────────────
RECONCILE_MS=15000      # solvency check interval

# ── Bot community / lobby tuning (cosmetic; defaults are fine) ───────────────
# POP_START=22
# POP_GROWTH=0.7
# POP_MAX=90
# LOBBY_MS=
# SEED_BOTS=
# BOT_BANK_MIN=60
# BOT_BANK_MAX=240
# BOT_STAKE_MIN=6
