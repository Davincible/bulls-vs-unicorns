# Direnv configuration for er-demo
#
# This file tells direnv to:
# 1. Load the nix-shell environment from shell.nix
#
# First time setup:
#   direnv allow
#
# After that, the environment loads automatically when you cd into this directory.

# Use nix-shell environment (loads shell.nix)
watch_file shell.nix
# Watch additional files for changes to trigger reload
watch_file package.json
watch_file bun.lockb
use flake
