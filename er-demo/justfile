# er-demo Project Commands
# Run `just` to see all available commands

# Default: show help
default:
    @just --list

# Install dependencies
install:
    bun install

# Start development server
dev:
    bun run dev

# Build for production
build:
    bun run build

# Preview production build
preview:
    bun run preview

# Type checking (no separate `check` script — this IS what `bun run build`'s `tsc -b` does; exposed
# standalone so it can run without also producing a build)
check:
    bun run tsc -b --noEmit

# === Testing ===

# Run unit tests (vitest). Currently: sim/erSim.ts + sim/hitEvents.ts parity tests against the
# checked-in Rust fixture (Phase 2). No E2E suite in this project — manual run-through is the test
# plan for the render/UI layers (snug-floating-mitten.md).
test:
    bun run test

# === Code Quality ===

# Lint code
lint:
    bun run lint

# === Utilities ===

# Clean build artifacts
clean:
    rm -rf dist node_modules coverage

# Fresh install (clean + install)
fresh: clean install

# Update dependencies
update:
    bun update

# Show outdated dependencies
outdated:
    bun outdated
